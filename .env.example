# Credenciales de la OAuth App de GitHub que da acceso al panel /admin.
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               https://adtaraguilla.es
#   Authorization callback URL: https://adtaraguilla.es/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dominio público de la web (necesario detrás de proxy para construir el
# redirect_uri de OAuth). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://adtaraguilla.es
