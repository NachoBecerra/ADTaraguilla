# ---------------------------------------------------------------------------
# Panel del club (/panel)
# ---------------------------------------------------------------------------

# Contraseña compartida para entrar a publicar. La elige el club.
CLAVE_PANEL=

# Token con el que el servidor escribe en el repositorio. Es lo que permite
# que quien publica NO necesite cuenta de GitHub.
# GitHub > Settings > Developer settings > Personal access tokens >
#   Fine-grained tokens > Generate new token
#   Repository access: solo NachoBecerra/ADTaraguilla
#   Permisos: Contents = Read and write
GITHUB_TOKEN=
GITHUB_REPO=NachoBecerra/ADTaraguilla
GITHUB_RAMA=main

# Dominio público de la web, para el sitemap y los enlaces al compartir.
NEXT_PUBLIC_SITE_URL=https://ad-taraguilla.vercel.app

# ---------------------------------------------------------------------------
# Aviso por correo cuando se bloquea el acceso al panel
# ---------------------------------------------------------------------------

# Tras 5 contraseñas fallidas seguidas desde el mismo sitio, el panel se
# bloquea 15 minutos y se manda un correo. Sin estas variables el bloqueo
# funciona igual y el aviso solo queda en el log del servidor.
# Clave de https://resend.com (API Keys).
RESEND_API_KEY=
# A quién avisar. Varias direcciones, separadas por comas.
AVISO_CORREO_A=
# Remitente. Sin dominio verificado en Resend, déjalo vacío: se usa su
# dirección de pruebas, que solo puede escribir a la cuenta dueña de la clave.
AVISO_CORREO_DE=
